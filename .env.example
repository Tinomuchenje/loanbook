# Copy to .env.local for local development. Never commit real keys.

# Written for you by `npx convex dev`
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# From the Clerk dashboard → API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Send signed-out people to our own sign-in page
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in

# Set this one on the Convex deployment, not here:
#   npx convex env set CLERK_JWT_ISSUER_DOMAIN https://<your-app>.clerk.accounts.dev
